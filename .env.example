# Public site URL, used for metadata. Set the production domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified restaurant WhatsApp number: country code + digits, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Official Google Maps link, verified with the restaurant.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Set ONLY verified restaurant details. Digits with country code, no + or spaces.
NEXT_PUBLIC_RESTAURANT_WHATSAPP=
NEXT_PUBLIC_RESTAURANT_MAPS_URL=
NEXT_PUBLIC_RESTAURANT_INSTAGRAM_URL=
# Leave blank until delivery policy is confirmed; 0 means confirmed free delivery.
NEXT_PUBLIC_DELIVERY_FEE=
# Flip only after the official menu and prices have been approved by the client.
NEXT_PUBLIC_MENU_CONFIRMED=false

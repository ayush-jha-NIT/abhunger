# Public site URL, used for metadata. Set the production domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified restaurant WhatsApp number: country code + digits, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Official Google Maps link, verified with the restaurant.
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# Set ONLY verified restaurant details. Digits with country code, no + or spaces.
NEXT_PUBLIC_RESTAURANT_WHATSAPP=917499668649
NEXT_PUBLIC_RESTAURANT_MAPS_URL=https://maps.app.goo.gl/VLofhWV8dE6YHxq58
NEXT_PUBLIC_RESTAURANT_INSTAGRAM_URL=
# Only for orders up to Rs 300, whose delivery charge is not yet confirmed.
# Strictly above Rs 300: free delivery within 10 km.
NEXT_PUBLIC_DELIVERY_FEE=
# Flip only after the official menu and prices have been approved by the client.
NEXT_PUBLIC_MENU_CONFIRMED=false
# Site is noindex until all approval switches + verified WhatsApp are present.
NEXT_PUBLIC_SITE_APPROVED=false
NEXT_PUBLIC_IMAGES_APPROVED=false
# Supply only confirmed operating hours. Otherwise the site shows a neutral message.
NEXT_PUBLIC_CONFIRMED_OPENING_HOURS=
NEXT_PUBLIC_RESTAURANT_FACEBOOK_URL=
NEXT_PUBLIC_RESTAURANT_YOUTUBE_URL=
